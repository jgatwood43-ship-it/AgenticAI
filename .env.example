# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── MySQL (via MCP) ──────────────────────────────────────────────────────────
MYSQL_HOST=XXXX
MYSQL_PORT=3306
MYSQL_USER=XXXX
MYSQL_PASSWORD=XXXX
MYSQL_DATABASE=AgenticAI

# ── Postgres Vector DB ───────────────────────────────────────────────────────
PG_HOST=XXXX
PG_PORT=5432
PG_USER=XXXX
PG_PASSWORD=XXXX
PG_DATABASE=AgenticAIvectorDB
PG_VECTOR_TABLE=document_embeddings

# ── Embedding Model ──────────────────────────────────────────────────────────
EMBED_MODEL_NAME=BAAI/bge-large-en-v1.5

# ── Semantic Splitter ────────────────────────────────────────────────────────
SEMANTIC_BREAKPOINT_THRESHOLD=95   # percentile threshold for splitting

# ── ReAct Agent ──────────────────────────────────────────────────────────────
REACT_MAX_ITERATIONS=10

